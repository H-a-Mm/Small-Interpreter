// This is a test for how a BPP program will look traslated from the python calc file

use std.io[input, print, panic] // (brakets around import lib decalres a selective import)

use module calc as cl // a module can depict a set of function, but also inharted onwnership

// This is a private function, will inheret onership of all variables from this script.
prv fn tokenize (expr) {

    var lst tokens = []

    var str lhs = ""
    var str op = ""
    var str rhs = ""

    for (expr.len() | i | i++) {

        match expr[i] {
            is_numeric() => {
                if (op != "") {
                    lhs.append(expr[i])
                } else {
                    rhs.append(expr[i])
                }
            }
            "+" | "-" | "*" | "/" => op.append(expr[i])

            _ => panic!("Invalid charecter entered at location -> {}", expr[i])
        }

        tokens.append(lhs, op, rhs)
        
    }
}

// This is a public function, you can import it as a module to other scripts, and also import ownership of other scopes as input.
#cl.barrow(onwnership)
pub interpret(tokens) {

    if (tokens[1] == "+") {
        return (tokens[0]).parse(int) + (tokens[2]).parse(int)
    { else if (tokens[1] == "-") {
        return (tokens[0]).parse(int) - (tokens[2]).parse(int)
    } else if (tokens[1] == "*") {
        return (tokens[0]).parse(int) * (tokens[2]).parse(int)
    } else if (tokens[1] == "/") {
        return (tokens[0]).parse(int) / (tokens[2]).parse(int)
    } else {
        panic!("Expected operator, found {}", tokens[1])
    }
}

// entry point
entry fn main() {
    var str user = input!(">> ") // String variable
    var lst tokens = tokenize(user.split(True)) // List object
    interpret(tokens)
}